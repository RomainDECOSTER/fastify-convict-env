{
  "name": "fastify-convict-env",
  "version": "2.0.4",
  "description": "Fastify plugin to parse environment variables",
  "main": "index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "coverage": "cross-env NAME=fastify-convict-env tap --cov --coverage-report=html",
    "lint": "standard --fix | snazzy",
    "lint:fix": "standard --fix",
    "test": "pnpm run test:unit && pnpm run test:typescript",
    "test:typescript": "tsd",
    "test:unit": "cross-env NAME=fastify-convict-env tap"
  },
  "keywords": [
    "fastify"
  ],
  "author": "Romain De coster - @RomainDECOSTER",
  "repository": {
    "url": "https://github.com/RomainDECOSTER/fastify-convict-env"
  },
  "license": "MIT",
  "devDependencies": {
    "@fastify/pre-commit": "^2.1.0",
    "@types/node": "^25.7.0",
    "cross-env": "^10.1.0",
    "fastify": "^5.0.0",
    "snazzy": "^9.0.0",
    "standard": "^17.1.2",
    "tap": "^21.0.1",
    "tsd": "^0.33.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "convict": "^6.2.4",
    "convict-format-with-validator": "^6.2.0",
    "dotenv": "^17.4.2",
    "fastify-plugin": "^5.0.1"
  },
  "pre-commit": [
    "lint",
    "test"
  ],
  "tsd": {},
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10"
    }
  },
  "packageManager": "pnpm@10.33.2",
  "publishConfig": {
    "access": "public"
  }
}
